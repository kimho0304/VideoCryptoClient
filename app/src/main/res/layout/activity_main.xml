<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Main">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#7F86AD"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:context=".MainActivity">

        <ScrollView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/linearLayout2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#7F86AD"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:context=".MainActivity">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="670px"
                    android:layout_marginLeft="50px"
                    android:layout_marginTop="50px"
                    android:layout_marginRight="50px"
                    android:layout_marginBottom="50px"
                    android:background="#525982"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:layout_marginBottom="50px"
                        android:background="#254678"
                        android:text=" Information "
                        android:textColor="#ffffff"
                        android:textSize="10pt" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20px"
                        android:text="  본 어플리케이션은 국민대학교에서 개발한 하드웨어 암호모듈 UMPLUG V1.0의 성능 테스트를 위한 테스트 앱이다.\n\n"
                        android:textColor="#ffffff"
                        android:textSize="7pt" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20px"
                        android:text="  하드웨어 암호모듈과 USB로 연결되고 사용자가 선택한 테스트를 통해 성능 결과를 확인할 수 있다.​"
                        android:textColor="#ffffff"
                        android:textSize="7pt" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="900px"
                    android:layout_marginLeft="50px"
                    android:layout_marginTop="50px"
                    android:layout_marginRight="50px"
                    android:layout_marginBottom="50px"
                    android:background="#525982"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:layout_marginBottom="50px"
                        android:background="#254678"
                        android:text=" Usage "
                        android:textColor="#ffffff"
                        android:textSize="10pt" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  우측 상단의 메뉴 버튼을 클릭하면 아래의 3가지 테스트를 선택할 수 있다."
                        android:textColor="#ffffff"
                        android:textSize="7pt" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="- Unit test"
                        android:textColor="#ffffff"
                        android:textSize="7pt" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="- Echo vs Encrypt test"
                        android:textColor="#ffffff"
                        android:textSize="7pt" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="- Aging test\n"
                        android:textColor="#ffffff"
                        android:textSize="7pt" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unit test"
                        android:textColor="#ffffff"
                        android:textSize="7pt" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Echo와 Encrypt을 각각 수행하는 테스트\n"
                        android:textColor="#ffffff"
                        android:textSize="7pt" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Echo vs Encrypt test"
                        android:textColor="#ffffff"
                        android:textSize="7pt" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  Echo와 Encrypt를 수행한 뒤 시간 차이를 측정하는 테스트\n"
                        android:textColor="#ffffff"
                        android:textSize="7pt" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aging test"
                        android:textColor="#ffffff"
                        android:textSize="7pt" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  하드웨어 암호모듈에 성능 부하를 주기 위해서 Echo vs Encrypt를 계속 실행하는 테스트\n(해당 테스트 결과는 서버로 전송되어 쌓임)\n"
                        android:textColor="#ffffff"
                        android:textSize="7pt" />
                </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>